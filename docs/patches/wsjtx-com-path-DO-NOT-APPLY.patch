@@ -562,7 +572,14 @@ HamlibTransceiver::HamlibTransceiver (logger_type * logger,
               || params.ptt_port != params.serial_port))
         {
 #if defined (WIN32)
-          m_->set_conf ("ptt_pathname", ("\\\\.\\" + params.ptt_port).toLatin1 ().data ());
+          // Avoid doubling \\.\ if the UI already stored an extended path.
+          QString ptt_path = params.ptt_port;
+          if (ptt_path.startsWith (QStringLiteral ("COM"), Qt::CaseInsensitive)
